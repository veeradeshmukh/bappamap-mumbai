# BappaMap Mumbai — Environment Configuration Template
# Copy this file to .env or .env.local for local development.

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 15+ with PostGIS 3.3+)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:bappapassword@localhost:5432/bappamap
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:bappapassword@localhost:5432/bappamap

# -----------------------------------------------------------------------------
# Admin Moderation Authentication
# -----------------------------------------------------------------------------
ADMIN_PASSWORD=bappa-admin-secret-2027
SECRET_KEY=bappamap_default_session_secret_dev_key_2027
ADMIN_COOKIE_NAME=bappa_admin_session
SESSION_MAX_AGE_SECONDS=86400

# -----------------------------------------------------------------------------
# Cloudflare Turnstile Bot Defense (Testing Keys)
# -----------------------------------------------------------------------------
# 1x0000000000000000000000000000000AA is Cloudflare's official testing secret key (Always Passes)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# -----------------------------------------------------------------------------
# DPDP Act Privacy Salt & Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_SALT=bappamap_dev_salt_local
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600

# -----------------------------------------------------------------------------
# Frontend Proxy URL
# -----------------------------------------------------------------------------
BACKEND_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Cloudflare R2 Object Storage (Optional: Local fallback used if unset)
# -----------------------------------------------------------------------------
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_QUARANTINE_BUCKET=bappamap-quarantine
# R2_PUBLIC_BUCKET=bappamap-public
# R2_PUBLIC_DOMAIN=https://photos.bappamap.in
